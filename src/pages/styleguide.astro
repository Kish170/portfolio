---
// Internal review page for design tokens (noindex). Remove or keep at
// ticket 10.
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const colors = [
  'bg',
  'surface',
  'text',
  'text-muted',
  'border',
  'accent',
  'accent-soft',
  'building',
];
const sizes = ['3xl', '2xl', 'xl', 'lg', 'base', 'sm', 'xs'];
---

<BaseLayout title="Styleguide" description="Design tokens review." noindex>
  <div class="container stack">
    <header class="row">
      <h1>Styleguide</h1>
      <ThemeToggle />
    </header>

    <section aria-labelledby="colors">
      <h2 id="colors" class="label">Colour</h2>
      <ul class="swatches">
        {
          colors.map((c) => (
            <li>
              <span class="swatch" style={`background: var(--color-${c})`} />
              <code>--color-{c}</code>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="type">
      <h2 id="type" class="label">Type</h2>
      {sizes.map((s) => <p style={`font-size: var(--text-${s})`}>text-{s}: Data platforms and AI systems</p>)}
      <p class="mono">Mono: 800 ms latency, 14% to 100% coverage</p>
      <p><a href="#type">Link style</a> <span class="badge">Building</span></p>
    </section>
  </div>
</BaseLayout>

<style>
  .stack {
    display: grid;
    gap: var(--space-12);
    padding-block: var(--space-12);
  }

  .stack > section {
    display: grid;
    gap: var(--space-4);
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .swatches li {
    display: grid;
    gap: var(--space-2);
  }

  .swatch {
    height: 3rem;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
  }

  .badge {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-2);
    color: var(--color-building);
    border: var(--border-width) solid currentColor;
    border-radius: var(--radius);
  }
</style>
